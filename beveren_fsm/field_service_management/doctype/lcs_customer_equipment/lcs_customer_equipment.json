{
  "name": "LCS Customer Equipment",
  "doctype": "DocType",
  "module": "Field Service Management",
  "naming_series": "CEQ-.YYYY.-",
  "autoname": "naming_series:",
  "is_submittable": 0,
  "track_changes": 1,
  "description": "Scale registry per customer. Equipment identification is free-text; calibration certificates live in SmarterCerts.",
  "fields": [
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "search_index": 1
    },
    {
      "fieldname": "service_address",
      "label": "Service Address",
      "fieldtype": "Link",
      "options": "Address",
      "in_list_view": 1,
      "description": "Filtered to addresses linked to the selected customer"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Active\nInactive\nRetired",
      "default": "Active",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "equipment_details_section",
      "label": "Equipment Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "manufacturer",
      "label": "Manufacturer",
      "fieldtype": "Data",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "model_number",
      "label": "Model Number",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "serial_number",
      "label": "Serial Number",
      "fieldtype": "Data",
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "capacity",
      "label": "Capacity",
      "fieldtype": "Data",
      "description": "e.g. 500 lb x 0.1 lb"
    },
    {
      "fieldname": "location_description",
      "label": "Location Description",
      "fieldtype": "Small Text",
      "description": "Where on customer premises this equipment is installed"
    },
    {
      "fieldname": "calibration_section",
      "label": "Calibration",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "calibration_interval_months",
      "label": "Calibration Interval (Months)",
      "fieldtype": "Int",
      "default": 12
    },
    {
      "fieldname": "last_calibration_date",
      "label": "Last Calibration Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "calibration_due_date",
      "label": "Calibration Due Date",
      "fieldtype": "Date",
      "read_only": 1,
      "description": "Computed: Last Calibration Date + Calibration Interval Months",
      "in_list_view": 1
    },
    {
      "fieldname": "smarter_certs_url",
      "label": "SmarterCerts URL",
      "fieldtype": "Data",
      "options": "URL",
      "description": "Link to this equipment's certificate record in SmarterCerts"
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "LCS Customer Equipment",
      "read_only": 1,
      "print_hide": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Dispatch Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "Field Technician",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0
    }
  ],
  "links": [],
  "actions": []
}